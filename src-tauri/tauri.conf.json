{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IncAsk",
  "version": "../package.json",
  "identifier": "th.co.gosoft.incask",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IncAsk",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Gosoft (Thailand)",
    "category": "Productivity",
    "shortDescription": "จัดหมวดหมู่อินซิเดนต์ด้วย AI",
    "longDescription": "IncAsk จัดหมวดหมู่อินซิเดนต์/ทิกเก็ตจากไฟล์ CSV หรือ Excel ด้วย LLM ของบริษัทผ่าน Gateway แล้วสรุปผลเป็น pivot",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "allowDowngrades": false,
      "wix": { "language": ["en-US"] },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Thai", "English"],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": { "installMode": "passive" }
    }
  }
}
