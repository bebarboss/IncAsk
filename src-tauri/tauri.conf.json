{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IncAsk",
  "version": "../package.json",
  "identifier": "th.co.gosoft.incask",
  "build": {
    "beforeDevCommand": "npm run build:report && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IncAsk",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "Gosoft (Thailand)",
    "category": "Productivity",
    "shortDescription": "AI incident categorization",
    "longDescription": "IncAsk categorizes incidents and tickets from CSV or Excel files with the company LLM via the Gateway and summarizes them as pivots.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "wix": {
        "language": [
          "en-US"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Thai",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/report.html": "resources/report.html"
    },
    "fileAssociations": [
      {
        "ext": [
          "incask"
        ],
        "name": "IncAsk Project",
        "description": "IncAsk Project",
        "role": "Editor",
        "mimeType": "application/x-incask"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NDg3MDQ2NzA4NTVEOEEKUldTS1hZVndSbkJJMXdnSlcveHFaYy9tR1ppcDVjbXdYK3VQTHNNUE8ydE50VGcrYnVLRXQzOEwK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
