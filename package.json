{
  "name": "incask",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env INCASK_MOCK=1 vite",
    "build": "tsc -b && vite build && vite build -c vite.report.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "tauri": "tauri",
    "tauri:mock": "tauri dev --config src-tauri/tauri.mock.conf.json",
    "build:report": "vite build -c vite.report.config.ts",
    "preview:report": "vite -c vite.report.config.ts --port 5181"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans-thai": "^5.1.0",
    "@fontsource/ibm-plex-sans-thai-looped": "^5.3.0",
    "@fontsource/sarabun": "^5.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.28",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^7.0.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
